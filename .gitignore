# ============================================
# .gitignore - Files NOT to upload to GitHub
# ============================================

# Environment variables (NEVER upload to GitHub)
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Build outputs
dist/
build/
.expo/
.expo-shared/
.next/
out/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Mobile builds
*.apk
*.app
*.aab
*.ipa

# Temp files
.cache/
temp/
tmp/
*.tmp

# Testing
coverage/
.jest_cache/

# Editor backup files
*.bak
*.swp

# Mac
.AppleDouble
.LSOverride
.env.local.swp
