# ============================================
# .env.local - Supabase Configuration
# ============================================

# 1. Go to https://supabase.com
# 2. Sign in to your project
# 3. Click Settings → API
# 4. Copy the values below:

# Replace YOUR_SUPABASE_URL with your actual URL (starts with https://xxxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Replace YOUR_ANON_KEY with your actual anon public key (long string starting with eyJ)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im94dmdyeXNla3h3amVheXF4YnZ0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYzMDM4MTIsImV4cCI6MjEwMTg3OTgxMn0.sd8UtlPTXBLdZ9Gsg9iyCK79d4l942cQ8DE6qWYSyl0

# Service role key (KEEP SECRET - do not share)
# Only needed if running backend functions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# INSTRUCTIONS:
# ============================================
# 1. Rename this file to .env.local (remove _TEMPLATE)
# 2. Replace the dummy values with your actual Supabase credentials
# 3. NEVER commit this file to GitHub (add to .gitignore)
# 4. The app will read these values automatically
# ============================================
